<Window x:Class="The_Assembler.frmHighlightedProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="HighlightedProduct" Height="450" Width="800" ResizeMode="NoResize">
    <Grid>

        <Border>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Purple" Offset="1.1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Image HorizontalAlignment="Left" Height="313" Margin="382,111,0,0" VerticalAlignment="Top" Width="732" Source="/White.png" Stretch="Fill">
            <Image.Effect>
                <DropShadowEffect/>
            </Image.Effect>
        </Image>
        <TextBlock x:Name="txtProductName" HorizontalAlignment="Left" Margin="400,123,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="33" Width="149" FontSize="22" Background="White"><Run Language="en-ie" Text="Product Name"/></TextBlock>
        <TextBlock x:Name="txtProductPrice" HorizontalAlignment="Left" Margin="400,156,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="149" FontFamily="Segoe UI Variable Display Light" FontStyle="Italic" FontSize="16" Background="White"><Run Language="en-ie" Text="Price Here"/></TextBlock>
        <TextBlock x:Name="txtProductDescription" HorizontalAlignment="Left" Margin="400,182,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="380" FontFamily="Segoe UI Variable Display Light" FontStyle="Italic" FontSize="14" Background="White" Height="127"><Run Language="en-ie" Text="Product Description here"/></TextBlock>
        <Image HorizontalAlignment="Left" Height="47" Margin="57,322,0,0" VerticalAlignment="Top" Width="70" Source="/placeholder.png"/>
        <Image HorizontalAlignment="Left" Height="47" Margin="153,322,0,0" VerticalAlignment="Top" Width="70" Source="/placeholder.png"/>
        <Image HorizontalAlignment="Left" Height="47" Margin="250,322,0,0" VerticalAlignment="Top" Width="70" Source="/placeholder.png"/>
        <TextBlock HorizontalAlignment="Left" Margin="400,326,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="33" Width="95" FontSize="22" Background="White"><Run Language="en-ie" Text="Quantity:"/></TextBlock>
        <Button Content="Add to Cart" HorizontalAlignment="Left" Margin="400,374,0,0" VerticalAlignment="Top" Height="39" Width="122" Click="Button_Click" Background="#FF63FBFF" FontSize="20" FontWeight="Bold"/>
        <Button Content="View Similar Products" HorizontalAlignment="Left" Margin="556,374,0,0" VerticalAlignment="Top" Height="39" Width="183" Click="Button_Click" Background="#FF404C4C" FontSize="16" Foreground="White" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="150,45,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="250" FontSize="36"><Run Language="en-ie" Text="The Assembler"/></TextBlock>
        <Image HorizontalAlignment="Left" Height="155" Margin="0,20,0,0" VerticalAlignment="Top" Width="163" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png"/>
        <xctk:IntegerUpDown x:Name="myUpDownControl" Value="1"  Minimum="1" Maximum="100" Margin="500,314,230,65" FontSize="16"/>
        <Image x:Name="imgProductImage" HorizontalAlignment="Left" Height="175" Margin="57,142,0,0" VerticalAlignment="Top" Width="272" Source="/placeholder.png">
            <Image.Effect>
                <DropShadowEffect/>
            </Image.Effect>
        </Image>
        <Button x:Name="btnLogIn" Content="Log In" Margin="0,10,174,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnCart" Content="Cart" Margin="0,10,94,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnHistory" Content="History" Margin="0,10,16,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Right">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>
