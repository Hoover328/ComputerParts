<Window x:Class="The_Assembler.frmMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="MainWindow" Height="489" Width="800" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="31*"/>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="572*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Margin="0,39,0,0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Purple" Offset="1.1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Rectangle Grid.Column="1" HorizontalAlignment="Left" Height="236" Margin="3,188,0,0" Stroke="Black" VerticalAlignment="Top" Width="732" Grid.ColumnSpan="2"/>
        <TextBox x:Name="txtSearchBar" Grid.Column="1" HorizontalAlignment="Left" Margin="110,130,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="259" Height="21" TextChanged="TextBox_TextChanged" Grid.ColumnSpan="2"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="110,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="250" FontSize="36" Grid.ColumnSpan="2"><Run Language="en-ie" Text="The Assembler"/></TextBlock>
        <Image Grid.Column="2" HorizontalAlignment="Left" Height="146" Margin="324,34,0,0" VerticalAlignment="Top" Width="214" Source="/onSale.png" Stretch="Fill">
            <Image.Effect>
                <DropShadowEffect/>
            </Image.Effect>
        </Image>
        <Image HorizontalAlignment="Left" Height="155" Margin="-9,42,0,0" VerticalAlignment="Top" Width="163" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png" Grid.ColumnSpan="2"/>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="100" Margin="105,284,0,0" VerticalAlignment="Top" Width="100" Grid.ColumnSpan="2"/>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="236" Margin="3,188,0,0" VerticalAlignment="Top" Width="732" Source="/White.png" Stretch="Fill" Grid.ColumnSpan="2">
            <Image.Effect>
                <DropShadowEffect/>
            </Image.Effect>
        </Image>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="3,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="155" Background="White"><Run Text="Highlighted"/><Run Language="en-ie" Text=" Products"/></TextBlock>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="83" Margin="10,223,0,0" VerticalAlignment="Top" Width="698" Stretch="Fill" Source="/LightGrey.png" Grid.ColumnSpan="2"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="155" Background="White" Height="19"><Run Language="en-ie" Text="Hardware"/><LineBreak/><Run Language="en-ie"/></TextBlock>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,306,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="155" Background="White" Height="29"><Run Language="en-ie" Text="Software"/><LineBreak/><Run/></TextBlock>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="83" Margin="10,322,0,0" VerticalAlignment="Top" Width="698" Stretch="Fill" Source="/LightGrey.png" Grid.ColumnSpan="2"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="165,286,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="39" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700" Grid.ColumnSpan="2"><Run Language="en-ie" Text="€750"/></TextBlock>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="216,286,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="39" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700"><Run Text="€"/><Run Language="en-ie" Text="500"/></TextBlock>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="165,286,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="39" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700" Grid.ColumnSpan="2"><Run Language="en-ie" Text="€750"/></TextBlock>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="191,385,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="39" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700" Grid.ColumnSpan="2"><Run Text="€"/><Run Language="en-ie" Text="150"/></TextBlock>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="196,385,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="40" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700"><Run Text="€"/><Run Language="en-ie" Text="100"/></TextBlock>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="461,381,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="39" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700"><Run Text="€"/><Run Language="en-ie" Text="100"/></TextBlock>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="110,114,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="365" FontFamily="Segoe UI Variable Display Light" FontStyle="Italic" Grid.ColumnSpan="2"><Run Text="Cant find a product you want"/><Run Language="en-ie" Text=" below? Search here!"/></TextBlock>
        <Button Click="btnProduct1_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="1" Margin="47,223,32,167">
            <Image Source="/GeForce 4060.png" Grid.ColumnSpan="2" Width="129" Height="97"/>
        </Button>
        <Button Click="btnProduct2_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="2" Margin="91,223,356,167">
            <Image Source="/GeForce 3060.png" Grid.ColumnSpan="2" Width="111" Height="83"/>
        </Button>
        <Button Click="btnProduct3_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="2" Margin="368,223,79,167">
            <Image Source="/GeForce 5060.jpg" Grid.ColumnSpan="2" Width="111" Height="83"/>
        </Button>
        <Button Click="btnProduct4_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="1" Margin="85,326,10,68">
            <Image Source="/photoshop.png" Grid.ColumnSpan="2" Width="111" Height="83"/>
        </Button>
        <Button Click="btnProduct5_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="2" Margin="94,326,376,68">
            <Image Source="/flStudio.png" Grid.ColumnSpan="2" Width="98" Height="69"/>
        </Button>
        <Button Click="btnProduct2_Click" Background="Transparent" BorderBrush="Transparent" Grid.Column="2" Margin="354,326,116,68">
            <Image Source="/maya.png" Grid.ColumnSpan="2" Width="98" Height="69"/>
        </Button>
        <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="472,286,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="47" Background="Black" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="18" Foreground="#FFFFC700"><Run Text="€"/><Run Language="en-ie" Text="1500"/></TextBlock>
        <Button x:Name="btnLogIn" Content="Log In" Margin="0,10,174,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424" Grid.Column="2">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnCart" Content="Cart" Margin="0,10,94,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57" Grid.Column="2">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnHistory" Content="History" Margin="0,10,16,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Right" Grid.Column="2">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnSearch" Content="Search" Margin="0,130,314,0" VerticalAlignment="Top" Click="btnSearch_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57" Grid.Column="2">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnAdmin" Content="ADMIN" Margin="0,443,16,0" VerticalAlignment="Top" Click="btnAdmin_Click" Width="60" HorizontalAlignment="Right" BorderThickness="1,1,1,1" Grid.Column="2" Foreground="Black">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFFF4141" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>

    </Grid>
</Window>
