<Window x:Class="The_Assembler.Cart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="Cart" Height="450" Width="800">
    <Grid>
        <Button Content="Log In" Margin="0,10,122,0" VerticalAlignment="Top" Click="Button_Click" Background="#FFD1B0F9" Width="61" HorizontalAlignment="Right"/>
        <Button Content="Cart" Margin="0,10,61,0" VerticalAlignment="Top" Click="Button_Click" Background="#FFE2FFFD" Width="61" HorizontalAlignment="Right"/>
        <Button Content="History" Margin="0,10,0,0" VerticalAlignment="Top" Click="Button_Click" Background="#FFE2FFFD" Width="61" HorizontalAlignment="Right"/>
        <Border>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Purple" Offset="1.1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        
        <Button Content="Log In" Margin="0,10,181,0" VerticalAlignment="Top" Click="Button_Click" Width="61" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button Content="Cart" Margin="0,10,101,0" VerticalAlignment="Top" Click="Button_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button Content="History" Margin="0,10,23,0" VerticalAlignment="Top" Click="Button_Click" Width="61" HorizontalAlignment="Right">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>
