<Window x:Class="The_Assembler.frmUpdateProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="frmUpdateProduct" Height="450" Width="800">
    <Grid>
        <Grid>
            <Border Margin="0,39,0,-1">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Maroon" Offset="1.1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="392" FontSize="36" Margin="161,0,0,0"><Run Language="en-ie" Text="Update"/><Run Text=" Products"/></TextBlock>
            </Border>
            <Image HorizontalAlignment="Center" Height="282" Margin="0,119,0,0" VerticalAlignment="Top" Width="732" Stretch="Fill" Source="/LightGrey.png">
                <Image.Effect>
                    <DropShadowEffect/>
                </Image.Effect>
            </Image>
            <Label Content="Product Name" HorizontalAlignment="Left" Margin="44,137,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.137,-0.459" Background="White"/>
            <TextBox x:Name="txtProductName" HorizontalAlignment="Left" Margin="147,139,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="259" Height="21" TextChanged="txtProductName_TextChanged"/>
            <Label Content="Product Description" HorizontalAlignment="Left" Margin="44,278,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.137,-0.459" Background="White"/>
            <TextBox x:Name="txtProductDescription" HorizontalAlignment="Left" Margin="179,278,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="310" Height="105" TextChanged="txtProductPrice_TextChanged"/>
            <Label Content="Product Price" HorizontalAlignment="Left" Margin="44,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="-1.137,-0.459" Background="White"/>
            <TextBox x:Name="txtProductPrice" HorizontalAlignment="Left" Margin="147,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="106" Height="21" TextChanged="txtProductPrice_TextChanged"/>
            <Label Content="Availability" HorizontalAlignment="Left" Margin="497,139,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.137,-0.459" Background="White"/>
            <CheckBox x:Name="chkAvailability" Content="In Stock" HorizontalAlignment="Left" Margin="583,141,0,0" VerticalAlignment="Top" FontSize="18" IsChecked="True"/>
            <Label Content="Product ID" HorizontalAlignment="Left" Margin="497,210,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.137,-0.459" Background="White"/>
            <TextBox x:Name="txtProductID" HorizontalAlignment="Left" Margin="583,212,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="106" Height="21" TextChanged="txtProductID_TextChanged" IsEnabled="False"/>
            <Image HorizontalAlignment="Left" Height="101" VerticalAlignment="Top" Width="164" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png" Margin="5,10,0,0"/>
            <Button x:Name="btnUpdateProduct" Content="Update Product" Margin="0,304,180,0" VerticalAlignment="Top" Click="btnUpdateProduct_Click" Width="90" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424" Height="44">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                    </LinearGradientBrush>

                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
                </Button.Effect>
            </Button>

        </Grid>
        <Button x:Name="btnLogIn" Content="Log In" Margin="0,10,174,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnCart" Content="Cart" Margin="0,10,94,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnHistory" Content="History" Margin="0,10,16,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Right">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>

    </Grid>
</Window>
