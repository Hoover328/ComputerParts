<Window x:Class="The_Assembler.frmProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="Products" Height="450" Width="800" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#087CF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
            <Setter Property="Background" Value="#687784"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <!-- Dark navigation header -->
        <Button x:Name="btnLogIn" Content="Log In" Margin="558,10,0,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Left" BorderThickness="1,1,1,1"  Foreground="#FF2B2424">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Image HorizontalAlignment="Left" Height="101" VerticalAlignment="Top" Width="164" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png" Margin="10,10,0,0" Grid.RowSpan="2"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="392" FontSize="36" Margin="174,39,0,0" Text="Products" Grid.RowSpan="2"/>
        <Border Margin="0,39,0,-1" Grid.RowSpan="3" Panel.ZIndex="-1">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Maroon" Offset="1.1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DataGrid x:Name="dgSearchedProducts" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="51,94,45,37" SelectionChanged="dgSearchedProducts_SelectionChanged"/>
        </Border>
        <Button x:Name="btnCart" Content="Cart" Margin="642,10,0,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Left" RenderTransformOrigin="0.237,0.57">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnHistory" Content="History" Margin="724,10,0,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Left">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>
        <TextBox x:Name="txtSearchBar" HorizontalAlignment="Left" Margin="174,34,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="286" Height="21" TextChanged="Search_TextChanged" Grid.Row="1"/>
        <Button x:Name="btnSearch" Content="Search" Margin="0,33,258,0" VerticalAlignment="Top" Click="btnSearch_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57" Grid.Row="1">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>

        <!-- Dark navigation header -->
    </Grid>
</Window>
