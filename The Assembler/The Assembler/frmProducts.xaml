<Window x:Class="The_Assembler.frmProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="Products" Height="450" Width="800" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#087CF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
            <Setter Property="Background" Value="#687784"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <!-- Dark navigation header -->

        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,29,0,19" Grid.RowSpan="2">
            <StackPanel Margin="42,18,42,25">
                <TextBlock Text="Products List" FontSize="17" FontWeight="SemiBold"
                           />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filters on the left -->
                    <Border Grid.Column="0" BorderBrush="#D0D6DC" BorderThickness="2,2,2,2"
                            CornerRadius="4" Padding="11" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Filters" FontSize="14" FontWeight="Bold"/>

                            <TextBlock Text="Category" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="CategoryCombo" Height="32" SelectedIndex="0" SelectionChanged="CategoryCombo_SelectionChanged" BorderBrush="#FFACACAC" OpacityMask="Black">
                                <ComboBox.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White"/>
                                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                                    </LinearGradientBrush>
                                </ComboBox.Background>
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="CPU"/>
                                <ComboBoxItem Content="GPU"/>
                                <ComboBoxItem Content="RAM"/>
                                <ComboBoxItem Content="Storage"/>
                                <ComboBoxItem Content="Motherboard"/>
                                <ComboBoxItem Content="Power Supply"/>
                            </ComboBox>

                            <TextBlock Text="Price Range" Style="{StaticResource FilterLabel}"/>
                            <TextBlock Text="Min Price (€)" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="MinPriceBox" Height="32" Padding="6,5"/>
                            <TextBlock Text="Max Price (€)" FontSize="11" Margin="0,7,0,3"/>
                            <TextBox x:Name="MaxPriceBox" Height="32" Padding="6,5"/>

                            <TextBlock Text="Brand" Style="{StaticResource FilterLabel}"/>
                            <ComboBox x:Name="BrandCombo" Height="32" SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Intel"/>
                                <ComboBoxItem Content="NVIDIA"/>
                                <ComboBoxItem Content="AMD"/>
                                <ComboBoxItem Content="Corsair"/>
                                <ComboBoxItem Content="Samsung"/>
                                <ComboBoxItem Content="ASUS"/>
                                <ComboBoxItem Content="Seasonic"/>
                                <ComboBoxItem Content="Western Digital"/>
                            </ComboBox>

                            <Button Content="Apply Filters" Style="{StaticResource BlueButton}"
                                    Margin="0,12,0,0" Click="ApplyFilters_Click"/>
                            <Button Content="Clear Filters" Height="28" Margin="0,6,0,0"
                                    Click="ClearFilters_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Sort, product grid, and pagination -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResultsText" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort by:" FontSize="12" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="SortCombo" Width="150" Height="31"
                                          SelectionChanged="SortCombo_SelectionChanged">
                                    <ComboBox.Background>
                                        <LinearGradientBrush EndPoint="0,1">
                                            <GradientStop Color="#FFF0F0F0"/>
                                            <GradientStop Color="#FFD16FEF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ComboBox.Background>
                                    <ComboBoxItem Content="Featured"/>
                                    <ComboBoxItem Content="Price: Low to High"/>
                                    <ComboBoxItem Content="Price: High to Low"/>
                                    <ComboBoxItem Content="Name: A to Z"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="ProductsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D3D3D3" BorderThickness="1" CornerRadius="4"
                                            Margin="0,0,12,15" Padding="9" MinHeight="245">
                                        <StackPanel HorizontalAlignment="Center">
                                            <!-- Image placeholder: replace with an Image control later -->
                                            <Grid Width="100" Height="100" Margin="0,0,0,9">
                                                <Border BorderBrush="#555555" BorderThickness="1"/>
                                                <Line X1="0" Y1="0" X2="100" Y2="100"
                                                      Stroke="#555555" StrokeThickness="1"/>
                                                <Line X1="100" Y1="0" X2="0" Y2="100"
                                                      Stroke="#555555" StrokeThickness="1"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                                       TextWrapping="Wrap" Width="135" Height="47"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding PriceLabel}" TextAlignment="Center"
                                                       Margin="0,3,0,16" FontSize="12"/>
                                            <Button Content="View Details" Tag="{Binding}"
                                                    Style="{StaticResource BlueButton}"
                                                    HorizontalAlignment="Center" Click="Details_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoResultsText" Text="No products match these filters."
                                   HorizontalAlignment="Center" Margin="0,30" Foreground="Gray"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Button x:Name="btnPrevious" Content="Previous"
                                    Style="{StaticResource PageButton}" Click="Previous_Click" Foreground="Black" BorderThickness="1,1,1,1">
                                <Button.Effect>
                                    <DropShadowEffect/>
                                </Button.Effect>
                                <Button.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White"/>
                                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <StackPanel x:Name="NumberButtons" Orientation="Horizontal"/>
                            <Button x:Name="btnNext" Content="Next" Margin="5,0,0,0"
                                    Style="{StaticResource PageButton}" Click="Next_Click" Foreground="Black" Width="56" BorderThickness="1,1,1,1">
                                <Button.Effect>
                                    <DropShadowEffect/>
                                </Button.Effect>
                                <Button.Background>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="White"/>
                                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#303030" Margin="10,0,10,10">
            <TextBlock Text="© 2026 The Assembler. All rights reserved."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
        </Border>
        <Button x:Name="btnLogIn" Content="Log In" Margin="558,10,0,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Left" BorderThickness="1,1,1,1"  Foreground="#FF2B2424">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FFD16FEF" Offset="1"/>
                </LinearGradientBrush>

            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Image HorizontalAlignment="Left" Height="101" VerticalAlignment="Top" Width="164" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png" Margin="10,10,0,0" Grid.RowSpan="2"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="392" FontSize="36" Margin="174,34,0,0" Text="Products" Grid.RowSpan="2"/>
        <Border Margin="0,39,0,-1" Grid.RowSpan="3" Panel.ZIndex="-1">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                    <GradientStop Color="White" Offset="0"/>
                    <GradientStop Color="Maroon" Offset="1.1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Button x:Name="btnCart" Content="Cart" Margin="642,10,0,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Left" RenderTransformOrigin="0.237,0.57">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
        <Button x:Name="btnHistory" Content="History" Margin="724,10,0,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Left">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFEFFFF"/>
                    <GradientStop Color="#FF9CFFF8" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
            </Button.Effect>
        </Button>

        <!-- Dark navigation header -->
    </Grid>
</Window>
