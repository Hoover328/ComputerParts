<Window x:Class="The_Assembler.frmAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:The_Assembler"
        mc:Ignorable="d"
        Title="frmAdmin" Height="450" Width="800">
    <Grid>
        <Grid Margin="0,0,0,-39">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31*"/>
                <ColumnDefinition Width="197*"/>
                <ColumnDefinition Width="572*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="3" Margin="0,39,0,38">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0.3">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Maroon" Offset="1.1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Rectangle Grid.Column="1" HorizontalAlignment="Left" Height="236" Margin="3,188,0,0" Stroke="Black" VerticalAlignment="Top" Width="732" Grid.ColumnSpan="2"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="110,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="392" FontSize="36" Grid.ColumnSpan="2"><Run Text="The Assembler"/><Run Language="en-ie" Text=" - ADMIN"/></TextBlock>
            <Image HorizontalAlignment="Left" Height="155" Margin="-9,42,0,0" VerticalAlignment="Top" Width="163" Source="/Screenshot_2026-10-06_113100_bg_removed.png.png" Grid.ColumnSpan="2"/>
            <Image Grid.Column="1" HorizontalAlignment="Left" Height="100" Margin="105,284,0,0" VerticalAlignment="Top" Width="100" Grid.ColumnSpan="2"/>
            <Image Grid.Column="1" HorizontalAlignment="Left" Height="236" Margin="3,188,0,0" VerticalAlignment="Top" Width="732" Source="/White.png" Stretch="Fill" Grid.ColumnSpan="2">
                <Image.Effect>
                    <DropShadowEffect/>
                </Image.Effect>
            </Image>
            <Button x:Name="btnLogIn" Content="Log In" Margin="0,10,174,0" VerticalAlignment="Top" Click="btnLogIn_Click" Width="60" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424" Grid.Column="2">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                    </LinearGradientBrush>

                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
                </Button.Effect>
            </Button>
            <Button x:Name="btnCart" Content="Cart" Margin="0,10,94,0" VerticalAlignment="Top" Click="btnCart_Click" Width="62" HorizontalAlignment="Right" RenderTransformOrigin="0.237,0.57" Grid.Column="2">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFFEFFFF"/>
                        <GradientStop Color="#FF9CFFF8" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
                </Button.Effect>
            </Button>
            <Button x:Name="btnHistory" Content="History" Margin="0,10,16,0" VerticalAlignment="Top" Click="btnHistory_Click" Width="60" HorizontalAlignment="Right" Grid.Column="2">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFFEFFFF"/>
                        <GradientStop Color="#FF9CFFF8" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" BlurRadius="5" ShadowDepth="3" Direction="270"/>
                </Button.Effect>
            </Button>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="105,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="166" FontSize="24" Grid.ColumnSpan="2" FontWeight="Bold"><Run Language="en-ie" Text="Add a Product"/></TextBlock>
            <TextBlock Grid.Column="2" HorizontalAlignment="Left" Margin="269,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="166" FontSize="24" FontWeight="Bold"><Run Language="en-ie" Text="Add a Product"/></TextBlock>
            <Button x:Name="btnAddProduct" Content="Add Product" Margin="0,284,536,0" VerticalAlignment="Top" Click="btnAddProduct_Click" Width="90" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424" Grid.Column="1" Grid.ColumnSpan="2" Height="44">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                    </LinearGradientBrush>

                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
                </Button.Effect>
            </Button>
            <Button x:Name="btnUpdateProduct" Content="Update Product" Margin="0,284,175,0" VerticalAlignment="Top" Click="btnUpdateProduct_Click" Width="90" HorizontalAlignment="Right" BorderThickness="1,1,1,1"  Foreground="#FF2B2424" Grid.Column="2" Height="44">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="#FFD16FEF" Offset="1"/>
                    </LinearGradientBrush>

                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect Color="#FFA2A2A2" Direction="270" ShadowDepth="3"/>
                </Button.Effect>
            </Button>

        </Grid>

    </Grid>
</Window>
